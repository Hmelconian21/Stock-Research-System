# Copy to .env and fill in. Load with: set -a; . ./.env; set +a

# Required by SEC EDGAR's fair-access policy (sent in the User-Agent header)
SEC_USER_AGENT_EMAIL=you@example.com

# Optional: email alerts via Gmail SMTP (use an App Password, not your login password)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
NOTIFY_EMAIL=you@gmail.com
